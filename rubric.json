{
  "schema_version": 5,
  "minimum_accept_score": 4,
  "registry_scores": [
    "statement_alignment",
    "definition_fidelity",
    "notability",
    "literature",
    "clarity"
  ],
  "mandatory_reject_below_minimum": [
    "notability"
  ],
  "steps": [
    {
      "id": "classification",
      "prompt": "prompts/00-classification.md",
      "required": true,
      "score_keys": [
        "classification"
      ],
      "inputs": [
        "policy:CONTRIBUTING.md",
        "policy:rubric.json",
        "policy:taxonomies/classification-guide.md",
        "formalization_metadata",
        "challenge_source",
        "mechanical_report"
      ]
    },
    {
      "id": "metadata",
      "prompt": "prompts/01-metadata.md",
      "required": true,
      "score_keys": [
        "clarity",
        "provenance"
      ],
      "inputs": [
        "policy:CONTRIBUTING.md",
        "policy:rubric.json",
        "formalization_metadata",
        "project_readme",
        "issue",
        "mechanical_report"
      ]
    },
    {
      "id": "statement_alignment",
      "prompt": "prompts/02-statement-alignment.md",
      "required": true,
      "score_keys": [
        "statement_alignment"
      ],
      "inputs": [
        "policy:CONTRIBUTING.md",
        "policy:rubric.json",
        "formalization_metadata",
        "challenge_source",
        "comparator_config",
        "lakefile",
        "lean_toolchain"
      ]
    },
    {
      "id": "definition_fidelity",
      "prompt": "prompts/03-definition-fidelity.md",
      "required": true,
      "score_keys": [
        "definition_fidelity",
        "auditability"
      ],
      "inputs": [
        "policy:CONTRIBUTING.md",
        "policy:rubric.json",
        "formalization_metadata",
        "challenge_source",
        "comparator_config",
        "mechanical_report"
      ]
    },
    {
      "id": "literature_notability",
      "prompt": "prompts/04-literature-notability.md",
      "required": true,
      "score_keys": [
        "notability",
        "literature"
      ],
      "inputs": [
        "policy:CONTRIBUTING.md",
        "policy:rubric.json",
        "formalization_metadata",
        "project_readme",
        "issue"
      ]
    },
    {
      "id": "proof_account",
      "prompt": "prompts/05-proof-account.md",
      "required": false,
      "when": "formalization metadata contains an informal proof account",
      "score_keys": [
        "proof_alignment"
      ],
      "inputs": [
        "policy:CONTRIBUTING.md",
        "policy:rubric.json",
        "formalization_metadata",
        "solution_source"
      ]
    },
    {
      "id": "synthesis",
      "prompt": "prompts/06-synthesis.md",
      "required": true,
      "inputs": [
        "policy:CONTRIBUTING.md",
        "policy:rubric.json",
        "all_previous_results",
        "mechanical_report",
        "issue"
      ]
    }
  ],
  "step_result": {
    "required_fields": [
      "step",
      "verdict",
      "summary",
      "findings",
      "scores"
    ],
    "verdicts": [
      "pass",
      "warn",
      "fail",
      "escalate"
    ]
  }
}
