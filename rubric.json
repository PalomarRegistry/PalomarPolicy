{
  "schema_version": 10,
  "finding_comment_policy": "all",
  "minimum_score": 4,
  "registry_scores": [
    "statement_alignment",
    "definition_fidelity",
    "notability",
    "literature",
    "clarity"
  ],
  "mandatory_reject_below_minimum": [
    "notability"
  ],
  "steps": [
    {
      "id": "classification",
      "requires_classification_coverage": true,
      "prompt": "prompts/00-classification.md",
      "required": true,
      "score_keys": [
        "classification"
      ],
      "inputs": [
        "policy:CONTRIBUTING.md",
        "policy:rubric.json",
        "policy:prompts/materiality.md",
        "policy:taxonomies/classification-guide.md",
        "formalization_metadata",
        "challenge_source",
        "mechanical_report"
      ]
    },
    {
      "id": "metadata",
      "prompt": "prompts/01-metadata.md",
      "required": true,
      "score_keys": [
        "clarity",
        "provenance"
      ],
      "inputs": [
        "policy:CONTRIBUTING.md",
        "policy:rubric.json",
        "policy:prompts/materiality.md",
        "formalization_metadata",
        "challenge_source",
        "project_readme",
        "submission",
        "mechanical_report",
        "previous_findings"
      ]
    },
    {
      "id": "statement_alignment",
      "requires_declaration_coverage": true,
      "prompt": "prompts/02-statement-alignment.md",
      "required": true,
      "score_keys": [
        "statement_alignment"
      ],
      "inputs": [
        "policy:CONTRIBUTING.md",
        "policy:rubric.json",
        "policy:prompts/materiality.md",
        "formalization_metadata",
        "challenge_source",
        "project_readme",
        "comparator_config",
        "lakefile",
        "lean_toolchain",
        "previous_findings"
      ]
    },
    {
      "id": "definition_fidelity",
      "requires_declaration_coverage": true,
      "prompt": "prompts/03-definition-fidelity.md",
      "required": true,
      "score_keys": [
        "definition_fidelity",
        "auditability"
      ],
      "inputs": [
        "policy:CONTRIBUTING.md",
        "policy:rubric.json",
        "policy:prompts/materiality.md",
        "formalization_metadata",
        "challenge_source",
        "project_readme",
        "comparator_config",
        "mechanical_report",
        "previous_findings"
      ]
    },
    {
      "id": "literature_notability",
      "requires_declaration_coverage": true,
      "prompt": "prompts/04-literature-notability.md",
      "required": true,
      "score_keys": [
        "notability",
        "literature"
      ],
      "inputs": [
        "policy:CONTRIBUTING.md",
        "policy:rubric.json",
        "policy:prompts/materiality.md",
        "formalization_metadata",
        "challenge_source",
        "project_readme",
        "comparator_config",
        "submission",
        "previous_findings"
      ]
    },
    {
      "id": "proof_account",
      "requires_declaration_coverage": true,
      "prompt": "prompts/05-proof-account.md",
      "required": false,
      "when": "an informal proof account appears in the Challenge documentation, a compared declaration docstring, the project README, or formalization metadata",
      "score_keys": [
        "proof_alignment"
      ],
      "inputs": [
        "policy:CONTRIBUTING.md",
        "policy:rubric.json",
        "policy:prompts/materiality.md",
        "formalization_metadata",
        "challenge_source",
        "project_readme",
        "comparator_config",
        "solution_source",
        "previous_findings"
      ]
    },
    {
      "id": "synthesis",
      "prompt": "prompts/06-synthesis.md",
      "required": true,
      "inputs": [
        "policy:CONTRIBUTING.md",
        "policy:rubric.json",
        "policy:prompts/materiality.md",
        "all_previous_results",
        "mechanical_report",
        "submission"
      ]
    }
  ],
  "step_result": {
    "required_fields": [
      "step",
      "outcome",
      "summary",
      "findings",
      "scores",
      "trust_level",
      "sources_checked",
      "declarations_checked",
      "codes_checked",
      "internal_notes"
    ],
    "outcomes": [
      "neutral",
      "warning",
      "failure"
    ]
  }
}
