{
  "$defs": {
    "score": {
      "maximum": 5,
      "minimum": 1,
      "type": "integer"
    },
    "sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The review as it is archived beside a record and served to anyone. It is a projection of the private review: scores, finding severity, private audit notes, and the top-level repetition of every finding message are removed. Every author-facing material finding remains once in passes[].findings. The shape is closed at every level so an unreviewed field cannot be served accidentally.",
  "properties": {
    "decision": {
      "enum": [
        "accept",
        "revise",
        "reject"
      ]
    },
    "mechanical_report": {
      "format": "uri",
      "type": "string"
    },
    "passes": {
      "items": {
        "additionalProperties": false,
        "description": "Closed, and for the same reason the root is closed: everything here is served. The projection removes scores, private audit notes, and each finding's severity by name. A review carrying any other unlisted field therefore fails validation rather than serving data whose visibility was never decided.",
        "properties": {
          "codes_checked": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "declarations_checked": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "findings": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "evidence": {
                  "minLength": 1,
                  "type": "string"
                },
                "message": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "evidence",
                "message"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "sources_checked": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "step": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "trust_level": {
            "enum": [
              "high",
              "qualified",
              null
            ]
          },
          "verdict": {
            "enum": [
              "pass",
              "warn",
              "fail"
            ]
          }
        },
        "required": [
          "verdict"
        ],
        "type": "object"
      },
      "minItems": 5,
      "type": "array"
    },
    "policy_commit": {
      "$ref": "#/$defs/sha"
    },
    "requested_changes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "reviewed_at": {
      "format": "date-time",
      "type": "string"
    },
    "reviewer_models": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": 2
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "$ref": "#/$defs/sha"
        },
        "repository": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit"
      ],
      "type": "object"
    },
    "submission_id": {
      "pattern": "^[0-9a-z]{12}$",
      "type": "string"
    },
    "summary": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "submission_id",
    "source",
    "mechanical_report",
    "policy_commit",
    "reviewed_at",
    "reviewer_models",
    "decision",
    "summary",
    "requested_changes",
    "passes"
  ],
  "title": "Palomar published review",
  "type": "object"
}
